# Copy this file to .env.local and fill in your values

# ── MongoDB Atlas ──────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/hcmlite

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=your-random-secret-here-min-32-chars

# ── App URLs ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# ── xAI Grok API (for AI assistant) ───────────────────────────
# Get your key from: https://console.x.ai/
AI_API_KEY=xai-your-grok-api-key
AI_MODEL=grok-3-mini
AI_BASE_URL=https://api.x.ai/v1

# ── Admin seed account ─────────────────────────────────────────
ADMIN_EMAIL=admin@hcmlite.com
ADMIN_PASSWORD=Pass123!

# ── Reseed secret (GET or POST /api/setup/reseed) ─────────────
RESEED_SECRET=hcmlite-reseed
